# Render backend URL + mobile env template — committed to document the Render
# endpoint and the full frontend env block new contributors need. Zero secrets.
#
# Usage: copy these lines into your local `apps/mobile/.env` (gitignored) and
# fill the Supabase anon values from the Supabase dashboard (Project Settings →
# API). Do NOT commit real keys here.
#
# The anon key is a public, RLS-gated identifier — but by convention we keep all
# real env material out of git so audits stay clean.

EXPO_PUBLIC_API_URL=https://valuesnapapp.onrender.com
EXPO_PUBLIC_USE_MOCK=false

# EXPO_PUBLIC_SUPABASE_URL=https://<your-project>.supabase.co
# EXPO_PUBLIC_SUPABASE_ANON_KEY=<copy from Supabase dashboard>
